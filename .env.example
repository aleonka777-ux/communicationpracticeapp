# Copy this file to .env.local for local development. Never commit real secrets.
# In Vercel, set these under Project Settings → Environment Variables instead.

# --- Supabase (required) ---------------------------------------------------
# Project URL and anon (public) key — from your Supabase project's API settings.
# Safe to expose to the browser (NEXT_PUBLIC_*); RLS is the real authorization boundary.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — from the same API settings page. SERVER-ONLY. Never expose this to the
# client. Used only for the narrow set of operations that legitimately need to bypass RLS
# (see /docs/ARCHITECTURE.md §4 and CLAUDE.md "Security constraints").
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI / Voice provider (optional) ----------------------------------------
# If unset, the app runs on a deterministic mock AI provider and voice is disabled, so the full
# text practice loop still works end-to-end with zero external accounts (see /docs/DECISIONS.md).
# Set this to enable real interlocutor replies, coaching evaluation, speech-to-text, and
# text-to-speech, all via the OpenAI API.
OPENAI_API_KEY=

# Optional overrides — sensible defaults are used if these are unset.
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=alloy

# --- Realtime voice (optional, behind a rollback switch) --------------------
# Off by default: the practice screen uses the batch STT -> LLM -> TTS path above until this is
# turned on and verified. See /docs/DECISIONS.md "Realtime voice rollout". Requires
# OPENAI_API_KEY to also be set.
REALTIME_VOICE_ENABLED=false

# Optional overrides — sensible defaults are used if these are unset. Note the Realtime voice
# list differs from the batch TTS voice list above (e.g. no "nova"/"onyx"/"fable") — do not reuse
# OPENAI_TTS_VOICE here.
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_REALTIME_VOICE=alloy
